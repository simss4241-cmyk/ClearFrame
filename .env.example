# ── Google Cloud ──────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

GCS_BUCKET=clearframe-scripts
FIRESTORE_DATABASE=(default)

# ── Parallel ──────────────────────────────────
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=advanced        # advanced | turbo
PARALLEL_MONITOR_FREQUENCY=1d        # 1h | 1d | 1w
PARALLEL_MONITOR_PROCESSOR=lite      # lite | base

# ── App ───────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8080
MONITOR_WEBHOOK_SECRET=
PORT=8080
